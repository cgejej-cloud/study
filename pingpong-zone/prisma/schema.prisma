generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String?
  phone               String?
  role                String               @default("user")
  eloRating           Int                  @default(1000)
  emailNotify         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  reservations        Reservation[]
  matchesAsPlayer1    Match[]              @relation("Player1Matches")
  matchesAsPlayer2    Match[]              @relation("Player2Matches")
  matchesWon          Match[]              @relation("WonMatches")
  seasonSnapshots     SeasonSnapshot[]
  passwordResetTokens PasswordResetToken[]
  tournamentPlayers   TournamentPlayer[]
  tmMatchesAsP1       TournamentMatch[]    @relation("TM_Player1")
  tmMatchesAsP2       TournamentMatch[]    @relation("TM_Player2")
  tmMatchesWon        TournamentMatch[]    @relation("TM_Winner")
}

model Table {
  id           String        @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean       @default(true)
  reservations Reservation[]
  blockedSlots BlockedSlot[]
}

model BlockedSlot {
  id        String   @id @default(cuid())
  tableId   String
  date      String
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  table     Table    @relation(fields: [tableId], references: [id])

  @@index([tableId, date])
}

model Reservation {
  id             String        @id @default(cuid())
  userId         String
  tableId        String
  date           String
  startTime      String
  endTime        String
  status         String        @default("confirmed")
  isRecurring    Boolean       @default(false)
  recurrenceEnd  String?
  parentId       String?
  reminderSent   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  table          Table         @relation(fields: [tableId], references: [id])
  parent         Reservation?  @relation("RecurringGroup", fields: [parentId], references: [id])
  children       Reservation[] @relation("RecurringGroup")

  @@index([userId, date])
  @@index([tableId, date, status])
  @@index([date, status])
  @@index([parentId])
}

model Match {
  id          String    @id @default(cuid())
  player1Id   String
  player2Id   String
  winnerId    String
  status      String    @default("confirmed")
  p1Score     Int?
  p2Score     Int?
  p1EloChange Int?
  p2EloChange Int?
  confirmedAt DateTime?
  seasonId    String?
  createdAt   DateTime  @default(now())
  player1     User      @relation("Player1Matches", fields: [player1Id], references: [id])
  player2     User      @relation("Player2Matches", fields: [player2Id], references: [id])
  winner      User      @relation("WonMatches", fields: [winnerId], references: [id])
  season      Season?   @relation(fields: [seasonId], references: [id])

  @@index([player1Id, status])
  @@index([player2Id, status])
  @@index([status, createdAt])
  @@index([seasonId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, isPinned, createdAt])
}

model Season {
  id        String           @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean          @default(false)
  createdAt DateTime         @default(now())
  matches   Match[]
  snapshots SeasonSnapshot[]
}

model SeasonSnapshot {
  id       String @id @default(cuid())
  userId   String
  seasonId String
  rating   Int
  rank     Int?
  wins     Int    @default(0)
  losses   Int    @default(0)
  user     User   @relation(fields: [userId], references: [id])
  season   Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

model Tournament {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      String             @default("open")
  maxPlayers  Int                @default(8)
  createdAt   DateTime           @default(now())
  players     TournamentPlayer[]
  matches     TournamentMatch[]

  @@index([status, createdAt])
}

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  player1Id    String?
  player2Id    String?
  winnerId     String?
  p1Score      Int?
  p2Score      Int?
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  player1      User?      @relation("TM_Player1", fields: [player1Id], references: [id])
  player2      User?      @relation("TM_Player2", fields: [player2Id], references: [id])
  winner       User?      @relation("TM_Winner", fields: [winnerId], references: [id])

  @@index([tournamentId, round])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  url       String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
