generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String?
  phone            String?
  role             String            @default("user")
  eloRating        Int               @default(1000)
  emailNotify      Boolean           @default(true)
  createdAt        DateTime          @default(now())
  reservations     Reservation[]
  matchesAsPlayer1 Match[]           @relation("Player1Matches")
  matchesAsPlayer2 Match[]           @relation("Player2Matches")
  matchesWon       Match[]           @relation("WonMatches")
  seasonSnapshots  SeasonSnapshot[]
}

model Table {
  id           String        @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean       @default(true)
  reservations Reservation[]
  blockedSlots BlockedSlot[]
}

model BlockedSlot {
  id        String   @id @default(cuid())
  tableId   String
  date      String
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  table     Table    @relation(fields: [tableId], references: [id])

  @@index([tableId, date])
}

model Reservation {
  id             String        @id @default(cuid())
  userId         String
  tableId        String
  date           String
  startTime      String
  endTime        String
  status         String        @default("confirmed")
  isRecurring    Boolean       @default(false)
  recurrenceEnd  String?
  parentId       String?
  reminderSent   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  table          Table         @relation(fields: [tableId], references: [id])
  parent         Reservation?  @relation("RecurringGroup", fields: [parentId], references: [id])
  children       Reservation[] @relation("RecurringGroup")

  @@index([userId, date])
  @@index([tableId, date, status])
  @@index([date, status])
  @@index([parentId])
}

model Match {
  id          String    @id @default(cuid())
  player1Id   String
  player2Id   String
  winnerId    String
  status      String    @default("confirmed")
  p1EloChange Int?
  p2EloChange Int?
  confirmedAt DateTime?
  seasonId    String?
  createdAt   DateTime  @default(now())
  player1     User      @relation("Player1Matches", fields: [player1Id], references: [id])
  player2     User      @relation("Player2Matches", fields: [player2Id], references: [id])
  winner      User      @relation("WonMatches", fields: [winnerId], references: [id])
  season      Season?   @relation(fields: [seasonId], references: [id])

  @@index([player1Id, status])
  @@index([player2Id, status])
  @@index([status, createdAt])
  @@index([seasonId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, isPinned, createdAt])
}

model Season {
  id        String           @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean          @default(false)
  createdAt DateTime         @default(now())
  matches   Match[]
  snapshots SeasonSnapshot[]
}

model SeasonSnapshot {
  id       String @id @default(cuid())
  userId   String
  seasonId String
  rating   Int
  rank     Int?
  wins     Int    @default(0)
  losses   Int    @default(0)
  user     User   @relation(fields: [userId], references: [id])
  season   Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
}
