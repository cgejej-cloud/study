# ──────────────────────────────────────────────────────────
# 로컬 개발: 이 파일을 .env.local 로 복사 (Next.js 가 자동 로드).
# Prisma CLI 는 .env 만 읽으므로 DATABASE_URL/DIRECT_URL 은 .env 에도 별도 저장 필요.
# 빠른 방법: cp .env.example .env.local && cp .env.example .env (DB 라인만 둘 다 동기화)
# ──────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ─────────────────────────────
# Neon 대시보드 > Connection Details > Connection string
# 로컬 Docker 사용 시: postgresql://pingpong:pingpong@localhost:5432/pingpong_dev?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Session ──────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET="your-secret-here-minimum-32-characters-long"

# ── App URL ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://pingpongzone.kr"

# ── Email (Resend) ───────────────────────────────────────
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
SMTP_FROM="탁구존 <noreply@pingpongzone.kr>"

# ── Web Push (VAPID) ─────────────────────────────────────
# 아래 명령으로 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:admin@pingpongzone.kr"

# ── Vercel Blob (프로필 사진 업로드) ───────────────────────
# Vercel 대시보드 > Storage > Blob → .env.local 에서 복사
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# ── Cron 보안 토큰 ────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
