# Database
DATABASE_URL="file:./dev.db"

# Auth - 프로덕션에서는 반드시 32자 이상의 강력한 랜덤 값으로 변경
# 생성 예: openssl rand -base64 32
SESSION_SECRET="change-me-in-production-minimum-32-chars"

# 사이트 URL (sitemap, OpenGraph 등에 사용)
NEXT_PUBLIC_SITE_URL="https://pingpong.example.com"
NEXT_PUBLIC_BASE_URL="https://pingpong.example.com"

# SMTP (선택) - 미설정 시 이메일은 콘솔 로그로만 출력됨
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="탁구존 <noreply@pingpongzone.kr>"
